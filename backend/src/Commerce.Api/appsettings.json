{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Upload": {
    "MaxFileSizeMb": 5,
    "MaxRows": 50000
  },
